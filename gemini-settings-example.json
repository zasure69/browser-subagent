{
  "mcpServers": {
    "browser-subagent": {
      "command": "/path/to/browser-subagent/venv/bin/python3",
      "args": ["-m", "browser_mcp_server"],
      "cwd": "/path/to/browser-subagent",
      "timeout": 60000,
      "env": {
        "PYTHONPATH": "/path/to/browser-subagent"
      }
    }
  }
}
